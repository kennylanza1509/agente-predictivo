# Copia este archivo a .env y rellena tus valores reales.
# NUNCA subas el archivo .env al repo (está en .gitignore).

# Canal de salida: correo (SMTP). Para Gmail usa una "contraseña de aplicación".
EMAIL_REMITENTE=tu_correo@gmail.com
EMAIL_PASSWORD=tu_app_password
EMAIL_DESTINO=destino@ejemplo.com

# Opcional, si más adelante usas un LLM por API:
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

LOG_LEVEL=INFO
